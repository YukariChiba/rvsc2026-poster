// ─────────────────────────────────────────────────────────────────────────────
// 行内文本组件：供主文档使用的、字形受控的小组件。
//
// 这些组件是主文档唯一被允许的「强调小字」手段：字体与字号一律取自
// lib/typography.typ，主文档不得再自行写 text(font: …) / text(size: …)。
// ─────────────────────────────────────────────────────────────────────────────

#import "../typography.typ" as typo

// 行内补充注释：小号灰字，常用于表格单元里对主条目的小字说明。
#let deepin-note(body) = text(
  font: typo.fonts.note,
  size: typo.sizes.note,
  fill: luma(110),
  body,
)
