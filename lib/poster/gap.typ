// ─────────────────────────────────────────────────────────────────────────────
// 块间距组件：deepin-gap。
//
// 主文档中段落与图示 / 表格 / 列表之间需要的纵向间距，一律经此组件产生。
// 具体 em 值集中在 lib/layout.typ 的 gap 字典，主文档只选择语义档位，
// 不得再自行写 v(…) 或任何长度值。
// ─────────────────────────────────────────────────────────────────────────────

#import "../layout.typ" as layout

// 语义档位：
//   "section" —— 区块之间，较大（如段落与时间线之间）
//   "block"   —— 段落与图示 / 表格 / 列表之间
//   "tight"   —— 较小，表格等与其后说明文字之间
#let deepin-gap(level) = v(layout.gap.at(level))
