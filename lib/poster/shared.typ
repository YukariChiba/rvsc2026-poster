// 解析主文档传入的图片路径：lib 组件位于子目录，而图片通常相对工程根目录书写，
// 因此统一转成「相对工程根」的绝对路径（以 / 开头）。
#let asset-path(path) = if path.starts-with("/") { path } else { "/" + path }
